{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "practice_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\d{8}-\\d{4}-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "format": "date-time"
    },
    "student": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "slug",
        "name"
      ],
      "additionalProperties": false
    },
    "source_snapshot": {
      "type": "object",
      "properties": {
        "repository": {
          "const": "otromas1234/material-asignaturas"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "repository",
        "tag"
      ],
      "additionalProperties": false
    },
    "plan_reference": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "commit": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$"
            },
            "session_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "minItems": 0
            }
          },
          "required": [
            "path",
            "commit",
            "session_ids"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "commit": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[0-9a-f]{40}$"
            },
            "source_snapshot": {
              "type": "object",
              "properties": {
                "repository": {
                  "const": "otromas1234/material-asignaturas"
                },
                "tag": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "repository",
                "tag"
              ],
              "additionalProperties": false
            },
            "references": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "year": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "read_status": {
                    "enum": [
                      "complete",
                      "partial"
                    ]
                  },
                  "included_locators": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "minItems": 1
                  },
                  "excluded_locators": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "locator": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "locator",
                        "reason"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "id",
                  "path",
                  "year",
                  "read_status",
                  "included_locators",
                  "excluded_locators"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "path",
            "commit",
            "source_snapshot",
            "references"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "practice_mode": {
      "enum": [
        "profile_based",
        "general"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        },
        "key_concepts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "description",
        "units",
        "key_concepts"
      ],
      "additionalProperties": false
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "type": "null"
              }
            ]
          },
          "key_concepts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0
          },
          "locators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "page",
                    "heading",
                    "section",
                    "range",
                    "region"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "path",
          "unit",
          "key_concepts",
          "locators"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "response_mode": {
            "enum": [
              "chat",
              "paper_image",
              "graph_text",
              "graph_image"
            ]
          },
          "requires_image": {
            "type": "boolean"
          },
          "max_score": {
            "type": "number",
            "minimum": 0
          },
          "source_ref_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "prompt",
          "response_mode",
          "requires_image",
          "max_score",
          "source_ref_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "practice_id",
    "created_at",
    "student",
    "subject",
    "source_snapshot",
    "plan_reference",
    "profile",
    "practice_mode",
    "scope",
    "source_refs",
    "questions"
  ],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:material-estudio-planificar:plan:1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "generated_on",
    "timezone",
    "title",
    "source_snapshot",
    "initial_knowledge",
    "schedule",
    "sources",
    "sessions",
    "totals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.3"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["active", "deleted"]
    },
    "plan_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generated_on": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "source_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "repository",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "initial_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percent",
        "basis"
      ],
      "properties": {
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "basis": {
          "enum": [
            "assumed",
            "provided_estimate",
            "provided_measured"
          ]
        }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_date",
        "deadline_date",
        "weekends_allowed",
        "session_budget_minutes",
        "mode",
        "exam_date",
        "daily_budget_minutes",
        "provenance"
      ],
      "properties": {
        "start_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "deadline_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "weekends_allowed": {
          "type": "boolean"
        },
        "session_budget_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "mode": {
          "enum": [
            "dated",
            "undated"
          ]
        },
        "exam_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "daily_budget_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_date",
            "exam_date",
            "deadline_date",
            "weekends_allowed",
            "daily_budget_minutes"
          ],
          "properties": {
            "start_date": {
              "enum": [
                "default_today",
                "provided",
                "not_applicable"
              ]
            },
            "exam_date": {
              "enum": [
                "provided",
                "not_applicable"
              ]
            },
            "deadline_date": {
              "enum": [
                "derived_before_exam",
                "provided",
                "not_applicable"
              ]
            },
            "weekends_allowed": {
              "enum": [
                "default",
                "provided"
              ]
            },
            "daily_budget_minutes": {
              "enum": [
                "default",
                "provided",
                "explicit_uncapped"
              ]
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "format",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "format": {
            "enum": [
              "pdf",
              "docx",
              "text",
              "other"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "subject",
          "units",
          "taught_status",
          "study_date",
          "kind",
          "optional",
          "content",
          "practice_prompt",
          "source_refs",
          "study_practice_minutes",
          "exam_minutes",
          "correction_minutes",
          "break_minutes",
          "total_minutes",
          "objective"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "units": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "taught_status": {
            "enum": [
              "taught",
              "not_taught",
              "partial",
              "unknown"
            ]
          },
          "study_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "study",
              "review",
              "buffer"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "practice_prompt": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "pages"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "pages": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "start",
                          "end"
                        ],
                        "properties": {
                          "start": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "end": {
                            "type": "integer",
                            "minimum": 1
                          }
                        }
                      },
                      "minItems": 1
                    }
                  ]
                }
              }
            },
            "minItems": 1
          },
          "study_practice_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "exam_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "correction_minutes": {
            "type": "integer",
            "minimum": 1
          },
          "break_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "total_minutes": {
            "type": "integer",
            "minimum": 3
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_minutes",
        "optional_minutes",
        "including_optional_minutes"
      ],
      "properties": {
        "required_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "optional_minutes": {
          "type": "integer",
          "minimum": 0
        },
        "including_optional_minutes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
